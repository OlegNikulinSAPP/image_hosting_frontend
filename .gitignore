
# .gitignore

```gitignore
# .gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Logs
*.log
logs/

# Environment variables
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Docker
docker-compose.override.yml

# Temporary files
tmp/
temp/

# Database
*.db
*.sqlite3

# Backups
backups/*.sql
!backups/.gitkeep

# Uploaded images
/images/*
!/images/.gitkeep